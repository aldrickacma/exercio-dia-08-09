programa {
  funcao inicio() {
    cadeia nome
 inteiro idade
 real notaFinal
 cadeia sexoOuGenero
 logico matriculado
 leia(nome)
 leia(idade)
 leia(notaFinal)
 leia(sexoOuGenero)
 leia(matriculado)
 escreva("Nome completo: ", nome, "\n")
 escreva("Idade: ", idade, "\n")
 escreva("Nota final: ", notaFinal, "\n")
 escreva("Sexo ou inicial do genero: ", sexoOuGenero, "\n")
 escreva("Matriculado: ", matriculado)
  }
}
